# ---- server ----
PORT=8787
NODE_ENV=development

# Shared database. When set, the server uses this Postgres (e.g. Supabase) so
# everyone on the team sees the same data. Leave BLANK to run a zero-setup
# in-process Postgres (PGlite) persisted under server/data/ — good for solo dev.
#
#   Supabase: dashboard → "Connect" → "URI" tab → copy, fill in your DB password
#   (Settings → Database → "Reset database password" if you don't have it).
#   Use the direct connection on port 5432.
DATABASE_URL=
# Alternative name accepted by the server when DATABASE_URL is not set.
SUPABASE_DB_URL=
# Optional local PGlite data directory. Defaults to server/data/pgdata.
DB_FILE=server/data/pgdata
# Set to 1 for hosted Postgres providers that require TLS.
PGSSL=0

# REQUIRED in production (>=16 chars). Dev persists one under server/data/.
AUTH_SECRET=
# Password assigned to every seeded demo account.
DEMO_PASSWORD=demo1234
# Background monitoring loop cadence in ms. 0 = manual (use the sim tick button).
MONITOR_INTERVAL_MS=0

# API request limits per IP. Increase only when your deployment needs it.
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=20

# ============================================================================
#  LLM reasoning layer  (optional — the app is fully deterministic without it)
# ============================================================================
# When configured, the LLM does REASONING / EXPLANATION / ORCHESTRATION only:
#   • Coordinator: chooses the remediation strategy (reroute vs reassign)
#   • Dispatch Agent: writes the human explanation of the assignment
#   • Monitoring Agent: narrates the risk alert and rates its urgency
#   • Order Agent: interprets the free-text delivery note into structured flags
# It NEVER produces distances, ETAs, scores, eligibility, auth, or DB writes —
# every LLM call is enum-constrained or display-only, validated, time-boxed,
# and falls back to deterministic logic on any error.
#
# Option A — organizer's gateway (Ollama-format proxy over AWS Bedrock):
LLM_GATEWAY_URL=https://api.softwaresystems.app
LLM_GATEWAY_API_KEY=
LLM_MODEL=sonnet4.5:latest
LLM_TIMEOUT_MS=8000

# Option B — direct Anthropic API (used only if the gateway vars above are unset):
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENT_MODEL=claude-sonnet-5

# ---- frontend (vite dev) ----
# Where the vite dev server proxies /api. Defaults to http://localhost:8787
API_TARGET=http://localhost:8787
# Vite also accepts this name; use one of API_TARGET or VITE_API_TARGET.
VITE_API_TARGET=http://localhost:8787

# ---- OpenStreetMap / routing (frontend) ----
# Nominatim geocoding, OSRM driving routes, and OSM-compatible tiles.
# Replace these with an approved provider or self-hosted endpoints for
# production deployments and follow each provider's usage policy.
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
VITE_ROUTING_URL=https://router.project-osrm.org/route/v1/driving
VITE_MAP_PROVIDER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Set to 1 to reset demo data when the server starts.
SEED_RESET=0

# ---- Google / Gmail sign-in (optional) ----
# Create an OAuth Web application in Google Cloud Console and add the exact
# redirect URI below to Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
