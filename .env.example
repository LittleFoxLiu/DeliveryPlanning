# ---- server ----
PORT=8787

# Shared database. When set, the server uses this Postgres (e.g. Supabase) so
# everyone on the team sees the same data. Leave BLANK to run a zero-setup
# in-process Postgres (PGlite) persisted under server/data/ — good for solo dev.
#
#   Supabase: dashboard → "Connect" → "URI" tab → copy, fill in your DB password
#   (Settings → Database → "Reset database password" if you don't have it).
#   Use the direct connection on port 5432.
DATABASE_URL=

# REQUIRED in production (>=16 chars). Dev persists one under server/data/.
AUTH_SECRET=
# Password assigned to every seeded demo account.
DEMO_PASSWORD=demo1234
# Background monitoring loop cadence in ms. 0 = manual (use the sim tick button).
MONITOR_INTERVAL_MS=0

# ---- optional LLM advisory layer ----
# When set, the Coordinator asks the model to CHOOSE between pre-validated
# remediation strategies (reroute vs reassign) and explain the choice.
# It never produces numbers, authorization, or DB writes.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5

# ---- frontend (vite dev) ----
# Where the vite dev server proxies /api. Defaults to http://localhost:8787
API_TARGET=http://localhost:8787
