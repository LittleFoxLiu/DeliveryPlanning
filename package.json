{
  "name": "delivery-planner",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "start": "tsx server/src/index.ts",
    "seed": "tsx server/src/seed.ts --reset",
    "db:setup": "tsx server/src/seed.ts --reset",
    "build": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "lint": "tsc -p tsconfig.server.json --noEmit && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/leaflet": "^1.9.22",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
